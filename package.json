    "desktop:build:windows": "tauri build --bundles msi,nsis",
    "desktop:build:all": "tauri build",
    "vector:install": "node scripts/vector-kb-runner.mjs install",
    "vector:build": "node scripts/vector-kb-runner.mjs build",
    "vector:serve": "node scripts/vector-kb-runner.mjs serve",
    "vector:serve:wsl": "cmd.exe /c C:\\dev\\aletheia\\scripts\\run-vector-serve-wsl.cmd",
    "vector:build:all:wsl": "cmd.exe /c C:\\dev\\aletheia\\scripts\\run-vector-build-all-wsl.cmd",
    "vector:search": "node scripts/vector-kb-runner.mjs search",
    "vector:status": "node scripts/vector-kb-runner.mjs status",
    "diagnose:scripture": "node scripts/diagnose-scripture.mjs",
    "smoke:desktop-launch": "node scripts/smoke-desktop-launch.mjs",
    "smoke:vector-kb": "node scripts/smoke-vector-kb.mjs",
    "smoke:production-ui": "node scripts/smoke-production-ui.mjs",
    "verify:production": "./scripts/verify-production.sh"
  },
  "dependencies": {
