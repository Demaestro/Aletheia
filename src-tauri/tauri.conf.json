{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Aletheia",
  "version": "0.1.0",
  "identifier": "com.aletheia.production",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5178",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Aletheia Production",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 1180,
        "minHeight": 760
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:5178 ws://127.0.0.1:5178; img-src 'self' data: asset: http://asset.localhost https://images.unsplash.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/bibles/*.json",
      "resources/models/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "tsp": false,
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "languages": ["English"],
        "installMode": "currentUser"
      }
    },
    "shortDescription": "Worship production scripture automation",
    "longDescription": "Aletheia listens to live audio, detects scripture references via AI, and sends verified verses to vMix, OBS, ProPresenter, Companion, and other production software in real time.",
    "category": "Productivity"
  },
  "plugins": {
    "updater": {
      "active": false,
      "dialog": false,
      "endpoints": [],
      "pubkey": ""
    }
  }
}
